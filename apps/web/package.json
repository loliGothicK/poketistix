{
  "name": "@poketistix/app",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "supabase start && pnpm db:setup:local && next dev",
    "b": "next build",
    "build": "next build",
    "build:vercel": "next build",
    "start": "next start",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ci": "vitest --run --reporter=junit --outputFile=../../test-results/vitest.xml",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --fix-dangerously .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "pretty": "oxlint --fix-dangerously . && oxfmt .",
    "check": "npx tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "supabase migration up",
    "db:push": "supabase db push",
    "db:setup:local": "pnpm db:migrate && pnpm db:seed",
    "db:reset:local": "supabase db reset --local && pnpm db:seed",
    "db:seed": "tsx src/lib/db/seed.ts",
    "d1:migrate": "drizzle-kit migrate --config drizzle.d1.config.ts",
    "d1:index": "tsx scripts/index-docs.ts",
    "renovate": "ncu -u && pnpm install",
    "i18n:check": "pnpm exec tsx scripts/check-i18n.ts",
    "generate:release-note": "npx tsx scripts/generate-blog.ts"
  },
  "dependencies": {
