{
  "name": "poketistix-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "b": "pnpm -r run build",
    "build:app": "pnpm --filter @poketistix/app run build",
    "build:wasm": "pnpm --filter @poketistix/damage-calc run build",
    "pack": "pnpm --filter @poketistix/damage-calc run build && pnpm --filter @poketistix/damage-calc pack",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "fmt": "pnpm -r run fmt",
    "pretty": "pnpm -r run pretty",
    "changeset": "changeset",
    "version": "changeset version && pnpm --filter @poketistix/app exec tsx scripts/generate-blog.ts && pnpm --filter @poketistix/damage-calc run sync-version",
    "prepare": "husky",
    "benchmark": "pnpm --filter @poketistix/app run benchmark",
    "check": "pnpm -r run check",
    "renovate": "pnpm -r run renovate"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "ts-morph": "catalog:",
    "wrangler": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,mdx,json}": "oxfmt",
    "*.rs": "rustfmt --edition=2024"
  },
  "volta": {
    "node": "26.9.0"
  },
  "packageManager": "pnpm@12.4.2"
}
